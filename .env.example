# --- Database ---
# Local dev (default): SQLite file, zero setup.
DATABASE_URL="file:./dev.db"
# Production: swap prisma/schema.prisma provider to "postgresql" and use e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Auth ---
# Long random string. Generate with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Admin account (seeded on `npm run db:seed`) ---
# This is the ONLY login that can reach /admin.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Sanskriti Admin"
