# --- Database (Postgres) ---
# App connection string (pooled connection is fine / recommended for serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# A direct (non-pooled) connection, used only for migrations (`prisma db push`).
# If your provider gives you a single URL, set this to the same value.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth ---
# Long random string. Generate with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Admin account (seeded on `npm run db:seed`) ---
# This is the ONLY login that can reach /admin.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Sanskriti Admin"

# --- Image uploads (Vercel Blob) ---
# Needed for the drag-and-drop photo uploader in the admin. Create a Blob store
# in your Vercel project (Storage tab) and Vercel adds this automatically; copy
# it here for local use. Without it, the admin can still paste image URLs.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
